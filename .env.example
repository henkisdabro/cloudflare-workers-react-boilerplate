# .env.example
# Cloudflare CLI Credentials for Local Development
#
# This file provides credentials for wrangler CLI commands.
# Copy to .env and fill in your values:
#
#   cp .env.example .env
#
# The .env file is gitignored and safe to store locally.
#
# These credentials enable:
#   - npm run deploy (deploy without browser login)
#   - npx wrangler d1 create ... (create databases)
#   - npx wrangler kv namespace create ... (create KV namespaces)
#   - Other wrangler CLI commands
#
# Alternative: Use `npx wrangler login` for browser-based authentication
# (simpler but requires periodic re-authentication)

# Cloudflare Account ID (32-character hex string)
# Find at: Dashboard → Workers & Pages → Right sidebar → Account ID
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token
# Create at: Dashboard → Profile → API Tokens → Create Token
# Use the "Edit Cloudflare Workers" template
CLOUDFLARE_API_TOKEN=